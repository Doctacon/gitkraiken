/* Rhizome — bright, quiet framing for high-contrast colored commit lanes. */
Screen {
    background: #f7fbfc;
    color: #14232c;
}

/* Never let hover popups cover the workspace or dialogs. Textual toggles
   display inline, so hide visibility instead (also excludes mouse hit-testing). */
Tooltip { visibility: hidden; }

Static, Label { color: #14232c; }
ModalScreen Input { background: #ffffff; color: #14232c; border: tall #a8c1c7; }
ModalScreen Input:focus { border: tall #006d77; }
Input > .input--placeholder, Input > .input--suggestion { color: #48616c; }
Button { min-width: 0; border: none; }
Button:focus { text-style: bold; }

/* Repository identity is the calm topmost anchor, not another toolbar. */
#repo-header, #brand {
    height: 2;
    padding: 0 2;
    background: #e4f0f1;
    color: #10242b;
    content-align: left middle;
    text-style: bold;
}
#repo-path { color: #48616c; text-style: none; }
#toolbar {
    height: 3;
    padding: 1 1 0 1;
    background: #edf4f5;
    border-bottom: tall #b7cdd1;
}
.tool, #open, #help, #refresh {
    height: 1;
    min-width: 7;
    margin-right: 1;
    padding: 0 1;
    background: #dbecee;
    color: #18323a;
}
.tool:hover, .tool:focus, #open:hover, #open:focus, #help:hover, #help:focus,
#refresh:hover, #refresh:focus {
    background: #c4e2e4;
    color: #10242b;
}
.tool.primary, #refresh {
    background: #007c78;
    color: #ffffff;
    text-style: bold;
}
#workspace-nav {
    height: 1;
    padding: 0 1;
    background: #edf4f5;
}
#workspace-nav Button {
    height: 1;
    margin-right: 1;
    padding: 0 1;
    background: #dbecee;
    color: #18323a;
}
#workspace-nav Button:hover, #workspace-nav Button:focus {
    background: #b9dfe1;
    color: #10242b;
}
/* Horizontal containers otherwise consume the vertical free space in history-panel. */
#search-bar { height: 1; min-height: 1; }
#history-caption { height: 1; min-height: 1; }
#graph-filter {
    width: 1fr;
    height: 1;
    padding: 0 1;
    border: none;
    background: #ffffff;
    color: #14232c;
}
#graph-filter:focus { background: #f6fcfc; border: none; }
#search-next, #clear-search {
    width: 6;
    min-width: 6;
    height: 1;
    margin-left: 1;
    padding: 0;
    background: #dbecee;
    color: #006d77;
}

#graph-style {
    width: 13;
    min-width: 13;
    height: 1;
    margin-left: 1;
    padding: 0;
    background: #dbecee;
    color: #006d77;
}
#graph-style:hover, #graph-style:focus { background: #c4e2e4; color: #10242b; }

/* Pending work deserves colour, but never the entire screen. */
#operation-banner {
    /* App turns this on only for conflicts/operations; absent state must take no row. */
    display: none;
    height: 2;
    padding: 0 2;
    background: #fff3df;
    color: #6b4300;
    border-bottom: tall #c68a35;
}
#operation-text { width: 1fr; content-align: left middle; text-style: bold; }
.operation-button {
    width: 10;
    height: 1;
    margin: 0 0 0 1;
    padding: 0 1;
    background: #f5d8a3;
    color: #5c3900;
}
.operation-button:hover, .operation-button:focus { background: #e7bd74; color: #432900; }

#workspace { height: 1fr; }
#refs-panel {
    width: 25;
    min-width: 15;
    padding: 1;
    background: #edf4f5;
}
#history-panel {
    width: 1fr;
    min-width: 34;
    padding: 0;
    background: #f8fbfb;
}
#inspector-panel {
    width: 46;
    min-width: 25;
    padding: 0;
    background: #f3f8f9;
}
#graph-workspace, #diff-workspace { height: 1fr; }
#history-heading {
    height: 1;
    margin: 0;
    padding: 0 1;
    color: #006d77;
    text-style: bold;
    background: #e7f1f2;
}
#history-caption { height: 1; padding: 0 1; color: #48616c; background: #edf4f5; }

/* A quiet canvas keeps lane colors readable, including on the selected row. */
#graph-table {
    height: 1fr;
    border: none;
    background: #f8fbfb;
}
#graph-table > .datatable--header {
    background: #e7f2f3;
    color: #36505b;
    text-style: bold;
}
#graph-table > .datatable--header-hover { background: #d8eeee; }
#graph-table > .datatable--cursor {
    background: #d8eeee;
    color: #14232c;
}
#graph-table > .datatable--hover { background: #edf7f8; }
#load-more {
    width: 1fr;
    height: 2;
    padding: 0 1;
    background: #e2f1f2;
    color: #006d77;
    text-style: bold;
}
#load-more:hover, #load-more:focus { background: #b9dfe1; color: #14232c; }

/* An explicit file activation temporarily replaces, but never rebuilds, the graph. */
#diff-toolbar {
    height: 2;
    padding: 0 1;
    background: #e7f1f2;
    border-bottom: tall #b7cdd1;
}
#back-to-graph {
    height: 1;
    margin-right: 1;
    padding: 0 1;
    background: #d8eeee;
    color: #005f68;
}
#back-to-graph:hover, #back-to-graph:focus { background: #b9dfe1; color: #10242b; }
#center-diff-title { width: 1fr; height: 1; color: #36505b; text-style: bold; }
#center-diff-scroll {
    height: 1fr;
    padding: 0 1;
    overflow-y: auto;
    background: #ffffff;
    border-left: tall #a8c1c7;
}
#center-diff { height: auto; min-height: 1; color: #18323a; }

TabbedContent { height: 1fr; background: #f3f8f9; }
TabbedContent ContentTab { color: #48616c; background: #e4f0f1; }
TabbedContent ContentTab.-active { color: #005f68; background: #d8eeee; text-style: bold; }
#inspector-tabs > ContentSwitcher, TabPane { height: 1fr; }
TabPane { padding: 1; }
#commit-changes, #wip-changes { height: 1fr; min-height: 8; }
/* Compact commit metadata leaves the whole inspector available to its file tree. */
#commit-detail {
    height: 4;
    min-height: 4;
    max-height: 4;
    overflow-y: hidden;
    padding: 0 1;
    color: #14232c;
}
/* Changed files fill the space formerly occupied by the inline diff. */
#commit-file-tree {
    height: 1fr;
    min-height: 5;
    margin-top: 1;
    padding: 0 1;
    border: round #a8c1c7;
    background: #ffffff;
    color: #18323a;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
}
#commit-file-tree > .tree--guides { color: #8aa5ad; }
#commit-file-tree > .tree--guides-hover { color: #48616c; }
#commit-file-tree > .tree--guides-selected { color: #006d77; }
#commit-file-tree > .tree--cursor, #commit-file-tree:focus > .tree--cursor {
    background: #d8eeee;
    color: #14232c;
    text-style: none;
}
/* Working copy keeps its staging controls and composer in the inspector. */
.wip-actions { height: 2; }
.wip-actions Button, #stage-all, #unstage-all {
    min-width: 8;
    height: 1;
    margin-right: 1;
    padding: 0 1;
    background: #d8eeee;
    color: #18323a;
}
.wip-actions Button:hover, .wip-actions Button:focus, #stage-all:hover,
#stage-all:focus, #unstage-all:hover, #unstage-all:focus { background: #b9dfe1; color: #10242b; }
#discard { background: #fde8e8; color: #8d2635; }
#discard:hover, #discard:focus { background: #f4caca; color: #651d28; }
#wip-table {
    height: 1fr;
    min-height: 3;
    border: round #a8c1c7;
    background: #ffffff;
}
#wip-empty {
    height: auto;
    min-height: 3;
    padding: 0 1;
    color: #48616c;
    background: #ffffff;
    border: round #a8c1c7;
}
#wip-table > .datatable--header {
    background: #e5eff1;
    color: #36505b;
    text-style: bold;
}
#wip-table > .datatable--cursor {
    background: #d8eeee;
    color: #14232c;
}
#staged-summary { height: 2; color: #36505b; }
#draft-status { height: 1; color: #48616c; }
.composer-label { height: 1; margin-top: 1; color: #36505b; }
#commit-message {
    height: 4;
    margin-top: 0;
    border: round #8eabb2;
    background: #ffffff;
    color: #14232c;
}
#commit-message:focus { border: round #007c78; }
#commit {
    width: 1fr;
    height: 2;
    margin-top: 1;
    background: #007c78;
    color: #ffffff;
    text-style: bold;
}
#commit:hover, #commit:focus { background: #006d77; }

#status-line, #key-hint {
    height: 1;
    padding: 0 2;
    background: #ffffff;
    color: #48616c;
}
#status-line { color: #36505b; }
.collapsed, .refs-hidden #refs-panel, .refs-hidden #refs-splitter,
.inspector-hidden #inspector-panel, .inspector-hidden #inspector-splitter { display: none; }

/* Root adds these classes from terminal width; no CSS media queries are needed in Textual. */
.compact #refs-panel { width: 22; }
.compact #inspector-panel { width: 36; }
.compact .tool, .compact #open, .compact #help, .compact #refresh { min-width: 5; padding: 0; }
.compact #toolbar { padding-left: 0; padding-right: 0; }
.narrow #refs-panel { width: 18; padding: 0 1; }
.narrow #inspector-panel { width: 30; }
.narrow .tool, .narrow #open, .narrow #help, .narrow #refresh { width: 5; min-width: 5; }
.narrow #graph-filter { min-width: 12; }

/* At 80×24 one task owns the canvas. Summoned panels preserve the graph,
   captured diff, and draft beneath them, and Back restores the primary view. */
.pane-constrained #repo-header { height: 1; padding: 0 1; }
.pane-constrained #toolbar { height: 2; padding-top: 0; }
.pane-constrained #pull, .pane-constrained #stash, .pane-constrained #pop { display: none; }
.pane-constrained .tool { width: auto; min-width: 7; }
.pane-constrained #refs-panel, .pane-constrained #refs-splitter,
.pane-constrained #inspector-panel, .pane-constrained #inspector-splitter { display: none; }
.pane-constrained.responsive-inspector #history-panel,
.pane-constrained.responsive-refs #history-panel { display: none; }
.pane-constrained.responsive-inspector #inspector-panel { display: block; width: 1fr; }
.pane-constrained.responsive-refs #refs-panel { display: block; width: 1fr; }
.pane-constrained #wip-changes { min-height: 3; }
.pane-constrained.task-files #staged-summary,
.pane-constrained.task-files .composer-label,
.pane-constrained.task-files #commit-message,
.pane-constrained.task-files #draft-status,
.pane-constrained.task-files #commit { display: none; }
.pane-constrained.task-composer .wip-actions,
.pane-constrained.task-composer #wip-changes { display: none; }
.pane-constrained.task-composer #commit-message { height: 1fr; min-height: 4; }
.pane-constrained.task-composer .composer-label { margin-top: 0; }
.pane-constrained #key-hint { padding: 0 1; }

/* At 60 columns the inspector gets 25, leaving 34 for the center + divider. */
.pane-tight #inspector-panel { width: 25; }
.pane-tight .wip-actions Button { min-width: 0; width: 1fr; margin-right: 0; padding: 0; }

/* Keep the pane toolbar useful instead of clipping ten terse controls. */
.pane-tight #fetch, .pane-tight #pull, .pane-tight #push, .pane-tight #branch,
.pane-tight #stash, .pane-tight #pop { display: none; }
.pane-tight #actions { width: 9; min-width: 9; }

ModalScreen { align: center middle; background: #36505b 28%; }
/* Branch and commit context menus are anchored dropdowns, not dimmed dialogs. */
BranchContextMenu { align: left top; background: transparent; }
#action-picker, #prompt-dialog {
    width: 54;
    height: auto;
    max-height: 22;
    padding: 1 2;
    border: round #4f8790;
    background: #e7f2f3;
}
.dialog-title { margin-bottom: 1; color: #006d77; text-style: bold; }
.dialog-detail { margin-bottom: 1; color: #36505b; }
#action-options { height: auto; max-height: 14; border: round #a8c1c7; background: #f5fafa; }
.dialog-buttons { height: 3; margin-top: 1; align: right middle; }
.dialog-buttons Button { margin-left: 1; }
